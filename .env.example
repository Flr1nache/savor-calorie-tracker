# For a local physical-phone build, use your computer's LAN IP, not localhost.
# A deployed website uses its own same-origin AI API by default.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Server-only secret. Never add this to an EXPO_PUBLIC_* variable.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Optional comma-separated origins for a separately hosted web frontend.
ALLOWED_ORIGINS=
